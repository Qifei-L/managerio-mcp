# Generate two different random values; never use sample values as credentials.
APP_AUTH_TOKEN=
MANAGER_TOKEN_ENCRYPTION_KEY=
MANAGER_API_BASE=https://your-company.manager.cloud/api2
# The first admin signs in as APP_ADMIN_USERNAME (default "admin") with APP_AUTH_TOKEN
# until they set their own password on the Account page.
# APP_LEGACY_BEARER=on keeps "Authorization: Bearer APP_AUTH_TOKEN" working for the admin
# during the move to personal access tokens; set it to off afterwards.
PUBLIC_URL=http://localhost:3000
PORT=3000
DATA_DIR=./data
APP_USER_ID=railway-owner
